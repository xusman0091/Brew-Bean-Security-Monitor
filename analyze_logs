
import re
from collections import Counter

# Read access.log
with open("access.log", "r") as file:
    log_data = file.readlines()

# Regex pattern to extract log details
log_pattern = (
    r'(?P<ip>\d{1,3}(?:\.\d{1,3}){3}) '
    r'- - \[(?P<time>.*?)\] '
    r'"(?P<method>\w+) (?P<url>\S+) HTTP/[\d.]+" '
    r'(?P<status>\d{3}) (?P<size>\d+)'
)

failed_ips = Counter()
unique_ips = set()

# Analyze each log entry
for line in log_data:
    match = re.search(log_pattern, line)

    if match:
        details = match.groupdict()

        ip = details["ip"]
        status = details["status"]

        unique_ips.add(ip)

        if status == "401":
            failed_ips[ip] += 1

# Display results
print("Total log entries:", len(log_data))
print("Unique IP addresses:", len(unique_ips))

print("\nFailed login attempts per IP:")

for ip, count in failed_ips.items():
    print(ip, ":", count)

print("\nSuspicious IP addresses (more than 5 failures):")

for ip, count in failed_ips.items():
    if count > 5:
        print(ip, ":", count, "failed attempts")


# Save analysis results to a report
with open("analysis_report.txt", "w") as report:

    report.write("BREW & BEAN CAFE - LOG ANALYSIS REPORT\n")
    report.write("=" * 45 + "\n\n")

    report.write(f"Total log entries: {len(log_data)}\n")
    report.write(f"Unique IP addresses: {len(unique_ips)}\n\n")

    report.write("Failed login attempts per IP:\n")

    for ip, count in failed_ips.items():
        report.write(f"{ip}: {count} failed attempts\n")

    report.write("\nSuspicious IP addresses (more than 5 failures):\n")

    for ip, count in failed_ips.items():
        if count > 5:
            report.write(f"{ip}: {count} failed attempts\n")

print("\nAnalysis report saved successfully!")
